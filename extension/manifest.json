{
  "manifest_version": 3,
  "name": "Media Controller",
  "version": "1.0",

  "permissions": [
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
  "https://www.youtube.com/*",
  "http://localhost:3000/*"
],

  "action": {},

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}