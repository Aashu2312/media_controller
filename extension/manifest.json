{
  "manifest_version": 3,
  "name": "Media Controller",
  "version": "1.0",

  "permissions": [
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "action": {},

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}